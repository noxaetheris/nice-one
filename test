local function getGuiContainer()
	local container = nil
	pcall(function()
		if type(gethui) == "function" then
			container = gethui()
		elseif CoreGui then
			container = CoreGui
		else
			container = LocalPlayer:WaitForChild("PlayerGui")
		end
	end)
	return container or LocalPlayer:WaitForChild("PlayerGui")
end

