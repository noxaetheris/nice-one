					fCorner.Parent = fill
		
					local isDragging = false
		
					local function updateFromPos(x)
						local trackAbsPos = track.AbsolutePosition.X
						local trackAbsSize = track.AbsoluteSize.X
						local rel = math.clamp((x - trackAbsPos) / trackAbsSize, 0, 1)
						local rawVal = min + (max - min) * rel
						local snapped = math.floor(rawVal / inc + 0.5) * inc
						curVal = math.clamp(snapped, min, max)
		
						valLbl.Text = tostring(curVal)
						fill.Size = UDim2.new((curVal - min) / math.max(max - min, 0.001), 0, 1, 0)
						if cb then pcall(cb, curVal) end
					end
		
