-- [DELTA SHIELD] Neutralizes TPS Anticheat to prevent getting kicked / flung out of map
task.spawn(function()
	pcall(function()
		local Players = game:GetService("Players")
		local LocalPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		-- 1. Legacy TPS Anticheat Remotes cleanup
		local b1 = ReplicatedStorage:FindFirstChild("b\7\n\7\n\7")
		if b1 then pcall(function() b1:Destroy() end) end
		local v1_rem = ReplicatedStorage:FindFirstChild("\n\7\n")
		if v1_rem then pcall(function() v1_rem:Destroy() end) end

		-- 2. KeepYourHeadUp_ Bypass (Prevents flinging/kicking out of map on Delta)
		local function neutralizeKeepYourHeadUp()
			pcall(function()
				local fe = workspace:FindFirstChild("FE")
				local actions = fe and fe:FindFirstChild("Actions")
				if actions then
					local ac = actions:FindFirstChild("KeepYourHeadUp_")
					if ac and not ac:GetAttribute("Neutralized") then
						ac:Destroy()
						local dummy = Instance.new("RemoteEvent")
						dummy.Name = "KeepYourHeadUp_"
						dummy:SetAttribute("Neutralized", true)
						dummy.Parent = actions
					end
				end
			end)
		end

		neutralizeKeepYourHeadUp()

		-- Auto-neutralize when KeepYourHeadUp_ respawns or player resets
		pcall(function()
			local fe = workspace:FindFirstChild("FE")
			local actions = fe and fe:FindFirstChild("Actions")
			if actions then
				actions.ChildAdded:Connect(function(child)
					if child.Name == "KeepYourHeadUp_" and not child:GetAttribute("Neutralized") then
						task.defer(neutralizeKeepYourHeadUp)
					end
				end)
			end
		end)

		if LocalPlayer then
			LocalPlayer.CharacterAdded:Connect(function()
				task.wait(0.2)
				neutralizeKeepYourHeadUp()
			end)
		end

		-- 3. Dynamic Anticheat Remote Revoker (Removes server kick traps)
		local function isAcRemote(n)
			return string.match(n, "^[a-zA-Z]+%-%d+%a*%-%d+%a*$") ~= nil
		end

		local function cleanRemotes(obj)
			pcall(function()
				for _, c in pairs(obj:GetChildren()) do
					if c:IsA("RemoteEvent") and isAcRemote(c.Name) then
						pcall(function() c:Destroy() end)
					end
					cleanRemotes(c)
				end
			end)
		end

		cleanRemotes(game)
	end)
end)

