			local max = (data.Range and data.Range[2]) or 100
			local inc = tonumber(data.Increment) or 1
			local def = tonumber(data.CurrentValue) or min
			local cb = data.Callback

			local curVal = math.clamp(def, min, max)

			local sFrame = Instance.new("Frame")
			sFrame.Size = UDim2.new(1, 0, 0, 46)
