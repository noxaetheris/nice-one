			local valLbl = Instance.new("TextLabel")
			valLbl.Text = tostring(curVal)
			valLbl.Font = Enum.Font.GothamBold
			valLbl.TextSize = 11
			valLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
			valLbl.TextXAlignment = Enum.TextXAlignment.Right
			valLbl.BackgroundTransparency = 1
			valLbl.Position = UDim2.new(0.7, 0, 0, 6)
			valLbl.Size = UDim2.new(0.3, -12, 0, 16)
			valLbl.Parent = sFrame

			local track = Instance.new("Frame")
			track.Size = UDim2.new(1, -24, 0, 6)
			track.Position = UDim2.new(0, 12, 0, 28)
			track.BackgroundColor3 = Color3.fromRGB(30, 32, 44)
			track.Parent = sFrame

			local trCorner = Instance.new("UICorner")
			trCorner.CornerRadius = UDim.new(1, 0)
			trCorner.Parent = track

			local fill = Instance.new("Frame")
			local ratio = (curVal - min) / math.max(max - min, 0.001)
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			fill.BackgroundColor3 = Color3.fromRGB(244, 63, 94)
			fill.BorderSizePixel = 0
			fill.Parent = track

			local fCorner = Instance.new("UICorner")
			fCorner.CornerRadius = UDim.new(1, 0)
			fCorner.Parent = fill

			local isDragging = false

			local function updateFromPos(x)
				local trackAbsPos = track.AbsolutePosition.X
				local trackAbsSize = track.AbsoluteSize.X
				local rel = math.clamp((x - trackAbsPos) / trackAbsSize, 0, 1)
				local rawVal = min + (max - min) * rel
				local snapped = math.floor(rawVal / inc + 0.5) * inc
				curVal = math.clamp(snapped, min, max)

				valLbl.Text = tostring(curVal)
				fill.Size = UDim2.new((curVal - min) / math.max(max - min, 0.001), 0, 1, 0)
				if cb then pcall(cb, curVal) end
			end

			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isDragging = true
					updateFromPos(input.Position.X)

					local conn
					conn = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							isDragging = false
							if conn then conn:Disconnect() end
						end
					end)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromPos(input.Position.X)
				end
			end)

			local sliderObj = {}
			function sliderObj:Set(v)
				local num = tonumber(v) or curVal
				curVal = math.clamp(num, min, max)
				valLbl.Text = tostring(curVal)
				fill.Size = UDim2.new((curVal - min) / math.max(max - min, 0.001), 0, 1, 0)
				if cb then pcall(cb, curVal) end
			end
			return sliderObj
		end

