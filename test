	function v2:SelectTab(t)
		if not t then return end
		for _, other in ipairs(tabs) do
			if other == t then
				other.Page.Visible = true
				TweenService:Create(other.Button, TweenInfo.new(0.2), {
					BackgroundColor3 = Color3.fromRGB(30, 32, 44),
					TextColor3 = Color3.fromRGB(255, 255, 255)
				}):Play()
				other.Indicator.Visible = true
			else
				other.Page.Visible = false
				TweenService:Create(other.Button, TweenInfo.new(0.2), {
					BackgroundColor3 = Color3.fromRGB(18, 19, 26),
					TextColor3 = Color3.fromRGB(140, 144, 162)
				}):Play()
				other.Indicator.Visible = false
			end
		end
		currentTab = t
	end

